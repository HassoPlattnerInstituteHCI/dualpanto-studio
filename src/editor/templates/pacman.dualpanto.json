    {
      "id": "l1",
      "name": "Corridor",
      "view": "square",
      "intro": "Level 1. Go right.",
      "script": "// Level 1: feel the corridor and follow it to the end.\nlevel.zone(\"End\").onEnter(async () => {\n  await sound.success();\n  await speak(\"Well done.\");\n  panto.loadLevel(\"Turns\");\n});\n",
