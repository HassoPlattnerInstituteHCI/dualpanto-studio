      "script": "// Level 3: pellets. Eat them all; speech counts how many are left.\nconst pellets = level.items();\nlet eaten = 0;\n\nfor (const pellet of pellets) {\n  pellet.onCollect(async () => {\n    eaten++;\n    const left = pellets.length - eaten;\n    if (left > 1) speak(left + \" left.\", { interrupt: true });\n    else if (left === 1) speak(\"One left.\", { interrupt: true });\n    else {\n      await sound.success();\n      await speak(\"Well done.\", { interrupt: true });\n      panto.loadLevel(\"Junctions\");\n    }\n  });\n}\n",
